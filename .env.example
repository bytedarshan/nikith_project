# Set these in your terminal/hosting environment before running.
PORT=3000
ADMIN_PASSWORD=replace-this-with-a-long-unique-password
COOKIE_SECRET=replace-with-a-random-secret-at-least-32-characters
# Use Asia/Kolkata for one common daily reset. Can change later.
GAME_TIMEZONE=Asia/Kolkata
# After 5 real taps, switch to observed heatmap. Earlier results use the editorial model.
MIN_CROWD=5
# Optional: persist data outside the project if deployed with a volume.
DATA_DIR=./data
